# Copy this file to deploy/.env and fill in your own values.
# deploy/.env is never committed (it is listed in .gitignore).

# The domain you own, for example hassounagreen.com
DOMAIN=hassounagreen.com

# Optional. Without it the app still works; only the generative design and
# the AI review need it. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
